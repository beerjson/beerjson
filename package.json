{
  "name": "@beerjson/beerjson",
  "version": "1.0.2",
  "description": "BeerJSON format",
  "main": "index.js",
  "types": "types/ts/beerjson.d.ts",
  "files": [
    "index.js",
    "js/validation.js",
    "json/",
    "types/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jest": "30.4.2",
    "json-dup-key-validator": "^1.0.2",
    "lodash": "4.18.1",
    "pixl-xml": "1.0.13",
    "prettier": "3.9.6"
  },
  "scripts": {
    "test": "jest",
    "gen-docs": "node js/gen-docs.js && prettier --write ./types/ts/beerjson.d.ts ./types/flow-typed/beerjson.js",
    "gen-docs:check": "npm run gen-docs && git diff --exit-code -- 'docs/*.json.md' types",
    "format": "prettier --write \"json/**/*.json\" \"js/**/*.js\" \"tests/**/*.js\" \"*.md\" \"adr/*.md\"",
    "format:check": "prettier --list-different \"json/**/*.json\" \"js/**/*.js\" \"tests/**/*.js\" \"*.md\" \"adr/*.md\""
  },
  "jest": {
    "verbose": true,
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "watchPathIgnorePatterns": [
      "converted"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerjson/beerjson.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/beerjson/beerjson/issues"
  },
  "homepage": "https://github.com/beerjson/beerjson#readme",
  "keywords": [
    "beerjson",
    "json-schema"
  ],
  "overrides": {
    "js-yaml": "^4.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
