{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/mash.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "MashProcedureType": {
      "type": "object",
      "description": "This defines the procedure for performing unique mashing processes.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Name of the mash procedure.",
          "type": "string"
        },
        "grain_temperature": {
          "description": "Initial grain temperature prior to the start of the mash.",
          "$ref": "measureable_units.json#/$defs/TemperatureType"
        },
        "notes": {
          "description": "Free text notes about the mash procedure.",
          "type": "string"
        },
        "mash_steps": {
          "description": "The steps that make up the mash, in the order they are performed.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "mash_step.json#/$defs/MashStepType"
          }
        }
      },
      "required": [
        "name",
        "grain_temperature",
        "mash_steps"
      ]
    }
  }
}
