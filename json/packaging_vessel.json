{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/packaging_vessel.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "PackagingVesselType": {
      "type": "object",
      "description": "PackagingVesselType - a per vessel representation of a packaging process.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "keg",
            "bottle",
            "cask",
            "tank",
            "firkin",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "package_date": {
          "$ref": "measureable_units.json#/$defs/DateType"
        },
        "start_temperature": {
          "$ref": "measureable_units.json#/$defs/TemperatureType"
        },
        "end_temperature": {
          "$ref": "measureable_units.json#/$defs/TemperatureType"
        },
        "step_time": {
          "$ref": "measureable_units.json#/$defs/TimeType"
        },
        "start_gravity": {
          "$ref": "measureable_units.json#/$defs/GravityType"
        },
        "end_gravity": {
          "$ref": "measureable_units.json#/$defs/GravityType"
        },
        "start_ph": {
          "$ref": "measureable_units.json#/$defs/AcidityType"
        },
        "end_ph": {
          "$ref": "measureable_units.json#/$defs/AcidityType"
        },
        "carbonation": {
          "type": "number"
        },
        "vessel_volume": {
          "$ref": "measureable_units.json#/$defs/VolumeType"
        },
        "vessel_quantity": {
          "type": "number"
        },
        "graphics": {
          "type": "array",
          "items": {
            "$ref": "packaging_graphic.json#/$defs/PackagingGraphicType"
          }
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
