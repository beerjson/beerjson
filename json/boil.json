{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/boil.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "BoilProcedureType": {
      "type": "object",
      "description": "BoilProcedureType defines the procedure for performing a boil. A boil procedure with no steps is the same as a standard single step boil.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "pre_boil_size": {
          "$ref": "measureable_units.json#/$defs/VolumeType"
        },
        "boil_time": {
          "$ref": "measureable_units.json#/$defs/TimeType"
        },
        "boil_steps": {
          "type": "array",
          "items": {
            "$ref": "boil_step.json#/$defs/BoilStepType"
          }
        }
      },
      "required": [
        "boil_time"
      ]
    }
  }
}
